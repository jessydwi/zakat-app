# Pastikan semua file teks pakai LF
* text=auto eol=lf

# PHP dan Blade templates
*.php text eol=lf
*.blade.php text eol=lf

# Konfigurasi dan environment
*.env text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Frontend assets
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Dokumentasi
*.md text eol=lf
*.txt text eol=lf

# Jangan ubah binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
